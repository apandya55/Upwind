FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UPWIND_PUBLIC_READONLY=1
WORKDIR /app
COPY requirements-runtime.lock ./
RUN pip install --no-cache-dir -r requirements-runtime.lock
COPY pyproject.toml ./
COPY backend/upwind ./backend/upwind
RUN pip install --no-cache-dir --no-deps .
EXPOSE 8000
CMD ["uvicorn", "upwind.api:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
