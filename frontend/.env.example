# Set this to the final public origin before a public build.
# Do not leave the localhost fallback in a production deployment.
VITE_SITE_URL=https://your-production-domain.example

# Public deployments use `explorer`; local development uses `local`.
VITE_APP_SURFACE=local

# Set to the public National API origin for a separately hosted API, e.g.
# https://api.upwind.example. Leave blank for same-origin local/Compose use.
# VITE_API_BASE_URL=
