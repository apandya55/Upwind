    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
