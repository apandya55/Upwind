# Set a DNS name that points to the host before public staging/production.
# Leave unset for local staging at https://localhost (Caddy local certificate).
UPWIND_DOMAIN=localhost

# Optional during local staging. Required for public canonical URLs, sitemap,
# robots.txt, and social metadata in the frontend build.
VITE_SITE_URL=

# Local development keeps /workspace. The public container uses `explorer`.
VITE_APP_SURFACE=local

# Optional for separate static-web/API hosts; blank means same-origin /api.
# VITE_API_BASE_URL=https://api.your-domain.example

# Optional: choose another location for generated, ignored deployment data.
# UPWIND_DEPLOYMENT_DATA_DIR=deployment-data

# Optional: Python executable used by scripts/prepare_deployment_data.sh.
# UPWIND_PYTHON=.venv/bin/python
