{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend ci --no-audit --no-fund",
  "buildCommand": "python scripts/prepare_vercel_bundle.py 2>/dev/null || true; (cd frontend && ([ -d node_modules/typescript ] || npm ci --no-audit --no-fund) && npm run build:vercel)",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "deployment-data/**",
      "excludeFiles": "{frontend/**,evaluations/**,backend/tests/**,docs/**,examples/**,artifacts/**,.local/**,node_modules/**,**/*.test.py,**/test_*.py}"
    }
  }
}
